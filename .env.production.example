# ==============================================================================
# DUTOJ / DMOJ Production Environment Template (.env.production.example)
# HƯỚNG DẪN:
# 1. Sao chép file này sang .env.production trên máy chủ: cp .env.production.example .env.production
# 2. Tạo các khóa bí mật ngẫu nhiên: openssl rand -hex 32
# 3. KHÔNG BAO GIỜ commit file .env.production thật vào Git!
# ==============================================================================

# ── Django Core Settings ──────────────────────────────────────────────────────
DJANGO_DEBUG=False
# Tạo khóa bằng lệnh: python3 -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=change-me-to-a-very-long-and-secure-random-secret-key
# Danh sách domain hoặc IP phân cách bởi dấu phẩy
DJANGO_ALLOWED_HOSTS=103.161.96.114,oj.yourdomain.com
SITE_NAME=DUTOJ
SITE_LONG_NAME=DUT Online Judge
SITE_DOMAIN=oj.yourdomain.com
DMOJ_REQUIRE_STAFF_2FA=True
DMOJ_SSL=1

# ── MariaDB Database ──────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-root-password
MYSQL_DATABASE=dmoj
MYSQL_USER=dmoj
MYSQL_PASSWORD=change-me-to-a-strong-database-user-password
MYSQL_HOST=db
MYSQL_PORT=3306

# ── Cache & Message Broker (Memcached & Redis) ─────────────────────────────────
MEMCACHED_HOST=memcached
MEMCACHED_PORT=11211
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Chat & WebSocket Realtime Daemon ──────────────────────────────────────────
# Key cho tính năng chat mã hóa: openssl rand -base64 32
CHAT_SECRET_KEY=change-me-to-a-base64-chat-key
# Key xác thực giữa Django và WebSocket Daemon (bắt buộc khớp nhau)
EVENT_DAEMON_KEY=change-me-to-a-secure-event-key
EVENT_DAEMON_SUBMISSION_KEY=change-me-to-a-secure-submission-key
# Internal URL mà container Django / Celery gọi tới wsevent daemon
EVENT_DAEMON_URL=http://wsevent:15100
# Public URL mà trình duyệt client kết nối tới qua Nginx WSS proxy
EVENT_DAEMON_PUBLIC_URL=wss://oj.yourdomain.com
ALLOWED_ORIGINS=https://oj.yourdomain.com

# ── Bridge & Judge Relay ──────────────────────────────────────────────────────
BRIDGED_JUDGE_PORT=9999
BRIDGED_DJANGO_PORT=9998
# Địa chỉ host của service bridge mà container web kết nối tới
BRIDGED_CONNECT_HOST=bridge
BRIDGED_CONNECT_PORT=9998

# ── Judge Configuration ───────────────────────────────────────────────────────
JUDGE_NAME=judge1
# Key xác thực của máy chấm với bridge (phải khớp với đăng ký trong DB qua manage.py addjudge)
JUDGE_AUTH_KEY=change-me-to-a-secure-judge-key
# Image của máy chấm thực thi. DMOJ judge-server được build từ repo LQDJudge/judge-server
JUDGE_IMAGE=vnoj/judge-tier1:latest

# ── Host Directory Mounts ─────────────────────────────────────────────────────
# Thư mục bind mount trên máy chủ host. Tạo các thư mục này trước khi deploy;
# Nginx host và các container sẽ dùng chung static/media/problem data.
STATIC_DIR=/opt/online-judge/static
MEDIA_DIR=/opt/online-judge/media
PROBLEM_DIR=/opt/online-judge/problem_data
